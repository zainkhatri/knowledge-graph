#!/usr/bin/env python3
"""Claude Code UserPromptSubmit hook → atlas.prompt_hook. Never blocks a prompt: any error
is swallowed and prints nothing."""
import json, os, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))


def main():
    # headless `claude -p` (autofix councils, scripts): the context is noise there
    if os.environ.get("CLAUDE_CODE_ENTRYPOINT", "").startswith("sdk"):
        return
    from atlas.prompt_hook import run
    out = run(json.load(sys.stdin), db=str(ROOT / "data" / "homelab_kg.db"),
              state_dir=Path.home() / ".claude" / "kg-hook")
    if out:
        print(json.dumps(out))


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
